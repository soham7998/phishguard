# ── Required ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/phishguard
JWT_SECRET=change-this-to-a-random-secret

# ── Enrichment APIs (free tiers work fine to start) ──────────────────────────
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
GREYNOISE_API_KEY=
URLSCAN_API_KEY=

# ── Screenshot service (optional — screenshotone.com free tier: 100/mo) ──────
SCREENSHOT_API_KEY=
SCREENSHOT_API_URL=https://api.screenshotone.com/take

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000

# ── Rate limits (per API key per day) ────────────────────────────────────────
FREE_DAILY_LIMIT=50
PRO_DAILY_LIMIT=5000
ENTERPRISE_DAILY_LIMIT=100000
